# ════════════════════════════════════════════════════════════
#  .env.example
#  複製這個檔案為 .env，填入實際值後使用。
#  ⚠️  .env 絕對不要 commit 到 git！（已加入 .gitignore）
# ════════════════════════════════════════════════════════════


# ── OmniRouter ───────────────────────────────────────────────
# 打進 OmniRouter 的 API key。
# 就是你在 test_monorouter.py 裡用的那把金鑰（MONOROUTER_API_KEY）。
# GitHub token 是 OmniRouter 內部自己管的，這裡不需要填。
OMNI_API_KEY=在這裡貼上你的完整金鑰

# OmniRouter 的 endpoint（本機測試用 localhost，GCP 部署時改成 container name）
# 本機測試：http://localhost:20128/v1
# Docker Compose 內：http://omni-router:8080/v1
OMNI_BASE_URL=http://localhost:20128/v1

# OmniRouter Docker image 名稱（只有 GCP 部署時才需要填）
# 本機測試可以不填
OMNI_ROUTER_IMAGE=ghcr.io/your-org/omni-router:latest


# ── 模型路由 ─────────────────────────────────────────────────
# 透過 OmniRouter 使用的模型名稱。
# 你的 OmniRouter 不支援 gpt-4o 直接命名，要用 OmniRouter 的 routing prefix。
# 建議選項：
#   auto/best-chat      → OmniRouter 自動選最佳對話模型（推薦，最省事）
#   gh/claude-sonnet-5  → 品質好，速度合理
#   auto/fast           → 快速便宜，適合測試
SEARCH_MODEL=auto/best-chat


# ── NewsAPI ──────────────────────────────────────────────────
# 免費申請：https://newsapi.org/register
# 免費方案：每天 100 次請求，足夠每日財經新聞使用
NEWS_API_KEY=your-newsapi-key-here


# ── Line Bot ─────────────────────────────────────────────────
# Line Developers Console > Channel > Messaging API > Channel access token
# 申請位置：https://developers.line.biz/console/
# LINE_CHANNEL_SECRET 不需要填（只有做 webhook 接收才用到，推播不需要）
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# 推播對象 ID，逗號分隔，可同時推給多個用戶或群組
# User ID：以 U 開頭（在 Line Bot 收到的 webhook event 裡取得）
# Group ID：以 C 開頭（把 bot 加入群組後，從 webhook event 取得）
LINE_TARGET_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
