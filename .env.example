# ════════════════════════════════════════════════════════════
#  .env.example
#  cp .env.example .env 後填入實際值
#  ⚠️  .env 絕對不要 commit 到 git！（已加入 .gitignore）
# ════════════════════════════════════════════════════════════

# ── OmniRouter ───────────────────────────────────────────────
# 打進 OmniRouter 的 API key（test_monorouter.py 裡用的那把金鑰）
OMNI_API_KEY=在這裡貼上你的完整金鑰

# OmniRouter SQLite 加密金鑰，從 ~/.omniroute/.env 複製 STORAGE_ENCRYPTION_KEY 的值
# 沒有這個 key，Docker 無法讀取已加密的 GitHub Copilot token
STORAGE_ENCRYPTION_KEY=從_~/.omniroute/.env_複製STORAGE_ENCRYPTION_KEY的值

# 本機直接跑時用 localhost；Docker Compose 內會自動用 container name，不用改
OMNI_BASE_URL=http://localhost:20128/v1

# OmniRouter Docker image（GCP 部署才需要，本機測試可保留預設）
OMNI_ROUTER_IMAGE=ghcr.io/diegosouzapw/omniroute:latest

# ── 模型路由 ─────────────────────────────────────────────────
# 建議選項：
#   auto/best-chat      → OmniRouter 自動選最佳對話模型（推薦）
#   gh/claude-sonnet-5  → 品質好，速度合理
#   auto/fast           → 快速便宜，適合測試
SEARCH_MODEL=auto/best-chat

# ── NewsAPI ──────────────────────────────────────────────────
# 免費申請：https://newsapi.org/register（每天 100 次請求，足夠用）
NEWS_API_KEY=your-newsapi-key-here

# ── Line Bot ─────────────────────────────────────────────────
# Line Developers Console > Messaging API > Channel access token
# 申請：https://developers.line.biz/console/
# 注意：LINE_CHANNEL_SECRET 不需要填（只有 webhook 接收才用到）
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# 推播對象 ID，逗號分隔
# User ID：以 U 開頭；Group ID：以 C 開頭
LINE_TARGET_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
